# Kbuild file for the DynamoRIO Linux kernel module.
#
# This file is self-contained so that any build system can drive it. Install it
# as Kbuild at the root of a tree with the following layout and run
# `make -C <kernel build dir> M=<tree root> modules`:
#
#   Kbuild                this file
#   configure.h           generated by DynamoRIO's configure step
#   configure_defines.h   generated by DynamoRIO's configure step
#   event_strings.h       generated from core/win32/events.mc
#   common/...            DynamoRIO's common/ directory
#   core/...              DynamoRIO's core/ directory
#
# Kbuild writes its outputs next to the sources, so the sources are typically
# mirrored into the tree with per-file symlinks rather than built in place.
# CMakeLists.txt in this directory sets up such a tree for the CMake build.

obj-m += dynamorio_module.o

# Add new source files here.
# Note: No source file may be named dynamorio_module.c because Kbuild composite
# targets cannot share a name with a component object file.
dr_objs := \
  core/kernel_linux/dynamorio_module_main.o \
  core/kernel_linux/kernel_interface.o \
  core/kernel_linux/os.o \
  core/buildmark.o \
  core/config.o \
  core/dispatch.o \
  core/dynamo.o \
  core/emit.o \
  core/fcache.o \
  core/fragment.o \
  core/hashtable.o \
  core/heap.o \
  core/io.o \
  core/link.o \
  core/loader_shared.o \
  core/module_list.o \
  core/moduledb.o \
  core/monitor.o \
  core/nudge.o \
  core/options.o \
  core/perscache.o \
  core/stats.o \
  core/string.o \
  core/synch.o \
  core/translate.o \
  core/utils.o \
  core/vmareas.o \
  core/ir/decode_shared.o \
  core/ir/disassemble_shared.o \
  core/ir/encode_shared.o \
  core/ir/instr_shared.o \
  core/ir/instrlist.o \
  core/ir/ir_utils_shared.o \
  core/ir/opnd_shared.o \
  core/ir/x86/decode.o \
  core/ir/x86/decode_fast.o \
  core/ir/x86/decode_table.o \
  core/ir/x86/disassemble.o \
  core/ir/x86/encode.o \
  core/ir/x86/instr.o \
  core/ir/x86/ir_utils.o \
  core/ir/x86/opnd.o \
  core/arch/arch.o \
  core/arch/clean_call_opt_shared.o \
  core/arch/emit_utils_shared.o \
  core/arch/interp.o \
  core/arch/mangle_shared.o \
  core/arch/proc_shared.o \
  core/arch/x86/clean_call_opt.o \
  core/arch/x86/emit_utils.o \
  core/arch/x86/mangle.o \
  core/arch/x86/proc.o \
  core/lib/instrument.o \
  core/lib/module_api.o \
  core/arch/x86/x86.o

# stubs.c is generated from the other objects; see below.
dynamorio_module-y := $(dr_objs) core/kernel_linux/stubs.o

# Flags shared by C and assembly sources, including the x86.asm preprocessing below.
dr_flags := \
  -I$(src) \
  -I$(src)/common \
  -I$(src)/core \
  -I$(src)/core/include \
  -I$(src)/core/kernel_linux \
  -I$(src)/core/arch \
  -I$(src)/core/arch/x86 \
  -I$(src)/core/drlibc \
  -I$(src)/core/ir \
  -I$(src)/core/ir/x86 \
  -I$(src)/core/lib \
  -I$(src)/core/unix \
  -DLINUX_KERNEL \
  -DDYNAMORIO_INTERNAL \
  -DDR_DO_NOT_DEFINE_MAX_MIN

ccflags-y += $(dr_flags) -Wframe-larger-than=4096
ifdef CONFIG_X86
# Disable compiler-generated return thunks (__x86_return_thunk) since objtool
# is disabled for the module and won't generate the .return_sites section needed
# for runtime patching.
ccflags-y += -mfunction-return=keep
endif

asflags-y += $(dr_flags) -Xassembler --noexecstack
ifdef CONFIG_AS_IS_LLVM
# LLVM's integrated assembler (used for kernels built with LLVM=1) does not
# accept the GNU as options below. -masm=intel selects Intel syntax, which it
# parses without register prefixes.
asflags-y += -masm=intel
else
asflags-y += \
  -Xassembler -mmnemonic=intel \
  -Xassembler -msyntax=intel \
  -Xassembler -mnaked-reg \
  -Xassembler --64
endif

# Disable objtool checks for all objects in this directory. DynamoRIO assembly (x86.asm)
# and low-level code contain custom return sequences, stack switches, and trampolines
# that do not adhere to kernel objtool/SLS conventions.
OBJECT_FILES_NON_STANDARD := y

# Preprocess x86.asm into x86.S. This replicates the preprocessing logic from
# make/cpp2asm_support.cmake and make/CMake_asm.cmake, which cannot be used with Kbuild.
quiet_cmd_dr_cpp2asm = CPP2ASM $@
      cmd_dr_cpp2asm = \
  $(CPP) -Wp,-MMD,$(depfile) -P -x c $(dr_flags) -DCPP2ASM -o $@ $< && \
  sed -i -e 's/@N@/\n/g' -e 's/@P@/\#/g' -e 's/\#\#//g' $@

$(obj)/core/arch/x86/x86.S: $(src)/core/arch/x86/x86.asm FORCE \
  ; $(call if_changed_dep,dr_cpp2asm)

targets += core/arch/x86/x86.S
clean-files += core/arch/x86/x86.S

# TODO i#8021: Remove the stubs and KBUILD_MODPOST_WARN once all kernel symbols
# are fully implemented.
#
# When Module.symvers is present (e.g. a built kernel or distro headers),
# stubs.c gets weak stubs for symbols that are referenced but neither defined by
# the module nor exported by the kernel, so that the module can be loaded during
# development. The stubs are not expected to be called: each one simply calls
# BUG(), so a runtime call would fail loudly with a kernel oops. stubs.c is
# derived from the other objects rather than from the linked module, so the
# module builds in a single pass.
#
# When Module.symvers is absent (e.g. an unbuilt kernel tree prepared with
# `make modules_prepare`), kernel exports can't be told apart from missing
# symbols, so stubs.c is left empty and modpost's unresolved symbol errors are
# turned into warnings for compile-only testing. scripts/Makefile.modpost
# includes this file before it reads KBUILD_MODPOST_WARN.
dr_symvers := $(wildcard $(objtree)/Module.symvers)
dr_stub_objs := $(addprefix $(obj)/,$(dr_objs))

ifneq ($(dr_symvers),)
quiet_cmd_dr_stubs = GEN     $@
      cmd_dr_stubs = \
  export LC_ALL=C; \
  $(NM) -u $(dr_stub_objs) > $@.nm; \
  awk '$$1 == "U" { print $$2 }' $@.nm | sort -u > $@.undef; \
  $(NM) --defined-only $(dr_stub_objs) > $@.nm; \
  { awk 'NF == 3 && $$2 ~ /[A-Z]/ { print $$3 }' $@.nm; \
    cut -f2 $(dr_symvers); \
    echo __this_module; } | sort -u > $@.def; \
  { echo '/* Auto-generated weak stubs for unported DynamoRIO symbols */'; \
    echo '\#include <linux/bug.h>'; \
    echo; \
    comm -23 $@.undef $@.def | \
      sed 's/.*/void __attribute__((weak)) &(void) { BUG(); }/'; } > $@; \
  rm -f $@.nm $@.undef $@.def
else
KBUILD_MODPOST_WARN := 1
quiet_cmd_dr_stubs = GEN     $@
      cmd_dr_stubs = \
  echo '/* No stubs: $(objtree)/Module.symvers not found */' > $@
endif

$(obj)/core/kernel_linux/stubs.c: $(dr_stub_objs) $(dr_symvers) FORCE \
  ; $(call if_changed,dr_stubs)

targets += core/kernel_linux/stubs.c
clean-files += core/kernel_linux/stubs.c
